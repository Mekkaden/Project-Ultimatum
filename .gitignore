!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# Signing key backup copies
SIGNING-KEYS-BACKUP/

# Built release artifacts
PLAYSTORE-UPLOAD/

# --- Secrets (NEVER commit; repo is public) ---
credentials.txt
*.jks
*.keystore
android/key.properties
.env.local.bak

# --- Build output / tooling caches (regenerable) ---
